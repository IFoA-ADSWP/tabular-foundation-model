# Copy to .env at repo root (gitignored) or export vars directly.
# TabPFN hosted-API key (https://tabpfn.com) — required by benchmark scripts.
TABPFN_API_KEY=your-key-here

# Optional: custom .env path instead of repo-root .env
# TABPFN_ENV_FILE=/path/to/.env

# Optional: output directory override used by src/cleanup_outputs.py
# OUTPUT_DIR=/path/to/outputs
